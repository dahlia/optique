{
  "name": "file-inspect",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "A tested, read-only Optique CLI recipe",
  "bin": { "file-inspect": "./dist/package/cli.js" },
  "engines": { "node": ">=24.15.0", "bun": ">=1.3.14" },
  "dependencies": {
    "@optique/core": "workspace:",
    "@optique/discover": "workspace:",
    "@optique/run": "workspace:"
  },
  "devDependencies": {
    "@optique/testing": "workspace:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "node --test src/*.test.ts scripts/*.test.ts",
    "test:bun": "bun test ./src ./scripts"
  }
}
