{
  "ensure_final_newline_on_save": true,
  "format_on_save": "off",
  "formatter": "none",
  "languages": {
    "JavaScript": {
      "language_servers": [
        "!deno",
        "..."
      ],
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "pnpm",
          "arguments": [
            "exec",
            "oxfmt",
            "--stdin-filepath",
            "{buffer_path}"
          ]
        }
      }
    },
    "TypeScript": {
      "language_servers": [
        "!deno",
        "..."
      ],
