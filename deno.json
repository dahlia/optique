{
  "workspace": [
    "packages/*",
    "examples/*",
    "benchmarks/startup"
  ],
  "imports": {
    "@clack/prompts": "npm:@clack/prompts@^1.6.0",
    "@inquirer/prompts": "npm:@inquirer/prompts@^8.3.0",
    "@jellybrick/dbus-next": "npm:@jellybrick/dbus-next@0.11.3",
    "@logtape/file": "jsr:@logtape/file@^2.2.2",
    "@logtape/logtape": "jsr:@logtape/logtape@^2.2.2",
    "@napi-rs/keyring": "npm:@napi-rs/keyring@2.0.0",
    "@standard-schema/spec": "npm:@standard-schema/spec@^1.1.0",
    "@types/node": "npm:@types/node@^24.0.0",
    "fast-check": "npm:fast-check@^4.7.0",
    "isomorphic-git": "npm:isomorphic-git@^1.36.1",
    "tsdown": "npm:tsdown@^0.13.0",
    "typescript": "npm:typescript@^5.8.3",
    "valibot": "jsr:@valibot/valibot@^1.2.0",
    "zod": "npm:zod@^4.0.0",
    "yaml": "npm:yaml@^2.9.1"
  },
  "unstable": [
    "temporal"
  ],
  "exclude": [
    ".agents/",
    ".claude/",
    ".github/",
    ".issues/",
    "docs",
    "tmp/startup-baseline",
    "tmp/startup-tests",
    "tmp/parse-scope",
    "scripts/types/",
    "scripts/check-types.ts",
    "scripts/check-types.test.ts",
    "scripts/tooling/"
  ],
  "fmt": {
    "exclude": [
      "*.md",
      "**/*.md",
      "*.yaml",
      "**/*.yaml",
      "*.yml",
      "**/*.yml",
      "packages/config/src/test-configs/*.json"
    ]
  },
  "tasks": {
    "check-versions": "node scripts/check_versions.ts",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env --allow-net --allow-sys --allow-ffi --env-file=.env.test"
  }
}
