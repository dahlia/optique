{
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "semi": true,
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "trailingComma": "all",
  "quoteProps": "preserve",
  "arrowParens": "always",
  "bracketSpacing": true,
  "sortImports": false,
  "sortPackageJson": false,
  "sortTailwindcss": false,
  "jsdoc": false,
  "embeddedLanguageFormatting": "off",
  "objectWrap": "preserve",
  "experimentalOperatorPosition": "end",
  "overrides": [
    {
      "files": [
        "**/*.json",
        "**/*.jsonc"
      ],
      "options": {
        "printWidth": 1
      }
    }
  ],
  "ignorePatterns": [
    "/.agents/",
    "/.claude/",
    "/.github/",
    "/.issues/",
    "/docs",
    "/tmp/startup-baseline",
    "/tmp/startup-tests",
    "/tmp/parse-scope",
    "/*.md",
    "/**/*.md",
    "/*.yaml",
    "/**/*.yaml",
    "/*.yml",
    "/**/*.yml",
    "/packages/config/src/test-configs/*.json",
    "/examples/file-inspect/dist/",
    "/examples/file-inspect/node_modules/",
    "/packages/clack/dist/",
    "/packages/clack/node_modules",
    "/packages/clack/tsdown.config.ts",
    "/packages/config/dist/",
    "/packages/config/node_modules",
    "/packages/config/tsdown.config.ts",
    "/packages/core/dist/",
    "/packages/core/tsdown.config.ts",
    "/packages/derived-defaults/dist/",
    "/packages/derived-defaults/node_modules",
    "/packages/derived-defaults/tsdown.config.ts",
    "/packages/discover/dist/",
    "/packages/discover/node_modules",
    "/packages/discover/tsdown.config.ts",
    "/packages/env/dist/",
    "/packages/env/node_modules",
    "/packages/env/tsdown.config.ts",
    "/packages/git/dist/",
    "/packages/git/tsdown.config.ts",
    "/packages/inquirer/dist/",
    "/packages/inquirer/node_modules",
    "/packages/inquirer/tsdown.config.ts",
    "/packages/keyring/dist/",
    "/packages/keyring/node_modules",
    "/packages/keyring/tsdown.config.ts",
    "/packages/logtape/dist/",
    "/packages/logtape/node_modules",
    "/packages/logtape/tsdown.config.ts",
    "/packages/man/dist/",
    "/packages/man/tsdown.config.ts",
    "/packages/prompt/dist/",
    "/packages/prompt/node_modules",
    "/packages/prompt/tsdown.config.ts",
    "/packages/run/dist/",
    "/packages/run/tsdown.config.ts",
    "/packages/standard-schema/dist/",
    "/packages/standard-schema/node_modules",
    "/packages/standard-schema/tsdown.config.ts",
    "/packages/temporal/dist/",
    "/packages/temporal/tsdown.config.ts",
    "/packages/testing/dist/",
    "/packages/testing/node_modules",
    "/packages/testing/tsdown.config.ts",
    "/packages/valibot/dist/",
    "/packages/valibot/node_modules",
    "/packages/valibot/tsdown.config.ts",
    "/packages/zod/dist/",
    "/packages/zod/node_modules",
    "/packages/zod/tsdown.config.ts"
  ]
}
