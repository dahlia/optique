{
  "name": "@optique/keyring",
  "version": "1.4.0",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "#src/": "./src/"
  },
  "exclude": [
    "dist/",
    "node_modules",
    "tsdown.config.ts"
  ],
  "tasks": {
    "build": "pnpm build",
    "test": "deno test --allow-read --allow-write --allow-env --allow-run --allow-net --allow-sys",
    "test:node": {
      "dependencies": [
        "build"
      ],
      "command": "node --test"
    },
    "test:bun": {
      "dependencies": [
        "build"
      ],
      "command": "bun test"
    },
    "test-all": {
      "dependencies": [
        "test",
        "test:node",
        "test:bun"
      ]
    },
    "test:native:deno": "deno test --node-modules-dir=manual --allow-env --allow-sys --allow-read=../../node_modules --allow-run --allow-ffi=../../node_modules src/native.test.ts",
    "test:native:node": {
      "dependencies": [
        "build"
      ],
      "command": "node --test src/native.test.ts"
    },
    "test:native:bun": {
      "dependencies": [
        "build"
      ],
      "command": "bun test src/native.test.ts"
    },
    "test:native": {
      "dependencies": [
        "test:native:deno",
        "test:native:node",
        "test:native:bun"
      ]
    }
  }
}
